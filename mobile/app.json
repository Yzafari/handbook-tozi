{
  "expo": {
    "name": "هندبوک توزیع",
    "slug": "handbook-distribution",
    "scheme": "handbookdistribution",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "برای ثبت تصویر تجهیزات و تشخیص متن به دوربین نیاز داریم.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "package": "com.gridhand.app",
      "versionCode": 1,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "ir.handbookdistribution.app"
    }
  }
}
