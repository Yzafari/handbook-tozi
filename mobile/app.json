{
  "expo": {
    "name": "هندبوک توزیع",
    "slug": "handbook-distribution",
    "scheme": "handbookdistribution",
    "version": "1.0.1",
    "icon": "./assets/photos/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "برای ثبت تصویر تجهیزات و تشخیص متن به دوربین نیاز داریم.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "icon": "./assets/photos/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/photos/icon2.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.gridhand.app",
      "versionCode": 2,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "ir.handbookdistribution.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "123c5a49-fc1e-4736-84b6-fd299d3ad1a7"
      }
    }
  }
}
