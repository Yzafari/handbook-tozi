# Copy to .env and fill in real values. .env is git-ignored.
# Generate secrets with: openssl rand -hex 32

# Local/staging defaults. Production refuses these placeholders: set NODE_ENV=production
# only after replacing every secret and the production-only values in docs/DEPLOYMENT.md.
NODE_ENV=development

POSTGRES_DB=gridhand
POSTGRES_USER=gridhand
POSTGRES_PASSWORD=change-me

# >= 32 chars
JWT_ACCESS_SECRET=
# exactly 64 hex chars (32 bytes)
ENCRYPTION_KEY=
# >= 16 chars
PAYMENT_WEBHOOK_SECRET=
# >= 32 chars
DATACENTER_SIGNING_SECRET=

FRONTEND_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Cookie policy for the browser refresh token. In production with HTTPS set
# COOKIE_SECURE=true; SameSite=None additionally requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

SMTP_HOST=localhost
SMTP_PORT=1025

# Datacenter storage service (docker-compose.datacenter.yml).
DATACENTER_URL=http://127.0.0.1:8081
DATACENTER_INTERNAL_TOKEN=
DATACENTER_PUBLIC_URL=

# Optional for development; required (with TLS and credentials) in production.
REDIS_URL=
REDIS_PASSWORD=
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
