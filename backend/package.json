{
  "name": "gridhand",
  "version": "1.0.0",
  "description": "Grid Hand SaaS Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/*.test.js ../datacenter/tests/*.test.mjs",
    "check": "node scripts/check-project.js && node --check ../datacenter/server.mjs",
    "worker:documents": "node src/workers/document-index.worker.js",
    "worker:ocr": "node src/workers/ocr.worker.js",
    "worker:all": "node src/workers/all.worker.js",
    "documents:import": "node scripts/import-documents.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "documents:reindex": "node scripts/reindex-documents.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "redis": "^6.3.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0"
  }
}
