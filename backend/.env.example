NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/handbook_distribution
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payment/verify
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=هندبوک توزیع <no-reply@example.invalid>
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
UPLOAD_DIR=uploads
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15
PAYMENT_PENDING_TTL_MINUTES=30
PAYMENT_REMINDER_DAYS_BEFORE=3

# Separate document storage service (private network only)
DATACENTER_URL=http://127.0.0.1:8081
DATACENTER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
DATACENTER_SIGNING_SECRET=replace-with-another-32-plus-random-secret
DATACENTER_PUBLIC_URL=
DATACENTER_MAX_FILE_BYTES=104857600

# OpenSearch document index (local development only; production requires HTTPS/auth)
OPENSEARCH_URL=http://127.0.0.1:9200
REDIS_PASSWORD=replace-with-a-strong-random-redis-password
REDIS_URL=redis://:replace-with-a-strong-random-redis-password@127.0.0.1:6379
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_MS=4000
OPENSEARCH_INDEX_TIMEOUT_MS=120000
OPENSEARCH_DOCUMENT_INDEX=handbook-documents-v1
DOCUMENT_MAX_INDEX_CHARS=5000000
DOCUMENT_WORKER_POLL_MS=1500
DOCUMENT_WORKER_MAX_ATTEMPTS=5

# Bulk document ingestion (set only for an import run)
DOCUMENT_IMPORT_DIR=/absolute/path/to/document-library
DOCUMENT_IMPORT_CONCURRENCY=3
DOCUMENT_IMPORT_VISIBILITY=PUBLIC
DOCUMENT_IMPORT_LANGUAGE=und
DOCUMENT_IMPORT_JOB_ROLES=
DOCUMENT_IMPORT_OWNER_ID=

OCR_MAX_FILE_BYTES=15728640
OCR_LANGUAGES=fas+eng
DOCUMENT_OCR_LANGUAGES=fas+eng
DOCUMENT_MAX_FILE_BYTES=104857600
OCR_WORKER_POLL_MS=1200
OCR_WORKER_MAX_ATTEMPTS=4
OCR_MAX_TEXT_CHARS=1000000

# Only when running the indexing/OCR worker in Docker; use host.docker.internal
WORKER_DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/handbook
