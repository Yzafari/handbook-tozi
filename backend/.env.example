# ---------- Runtime ----------
NODE_ENV=development
PORT=4000

# ---------- Database ----------
# Matches docker-compose postgres (exposed on localhost:5432)
DATABASE_URL=postgresql://app:app_password@localhost:5432/appdb?schema=public

# ---------- URLs / CORS ----------
FRONTEND_URL=http://localhost:5173
# Comma-separated whitelist of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---------- Secrets ----------
# Min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_only_change_me_jwt_access_secret_0123456789abcdef
# Exactly 64 hex chars (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# true in production (HTTPS), false for local http
COOKIE_SECURE=false

# ---------- Payment (Zarinpal) ----------
# Any UUID-format value works in sandbox mode
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payment/verify
# Min 16 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=dev_only_webhook_secret_change_me

# ---------- Email (MailHog in dev: SMTP 1025, UI http://localhost:8025) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="App <no-reply@localhost>"

# ---------- Seed ----------
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# ---------- Uploads ----------
UPLOAD_DIR=uploads